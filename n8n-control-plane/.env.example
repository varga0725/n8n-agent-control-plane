# n8n Agent Control Plane — configuration.
# Copy to .env (kept out of version control) and fill in. Secrets live ONLY here.

# Base URL of the instance API. Should end with /api/v1 (normalized if not).
N8N_BASE_URL=https://your-n8n-host/api/v1

# API key from the n8n UI: Settings -> n8n API -> Create an API key.
# NEVER commit this. It is never logged, never echoed, never put in audit records.
N8N_API_KEY=

# Networking
N8N_REQUEST_TIMEOUT_MS=30000
N8N_MAX_RETRIES=3

# Safety switches — default to the safe setting. Only the operator flips these;
# an agent prompt cannot.
N8N_ALLOW_DESTRUCTIVE=false
N8N_ALLOW_PRODUCTION_WRITES=false

# Defaults / behavior
N8N_DEFAULT_PROJECT_ID=
N8N_AUDIT_LOG_ENABLED=true
N8N_REDACT_SECRETS=true
N8N_REDACT_EXECUTION_DATA=true
N8N_BACKUP_DIR=./backups
N8N_AUDIT_DIR=./audit

# Beta features — only honored if the instance's /discover reports them enabled.
# (Set on the n8n server, shown here for reference.)
# N8N_PUBLIC_API_PACKAGES_ENABLED=true
