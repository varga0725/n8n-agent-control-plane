{
  "name": "Order Intake & Fulfillment Pipeline",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "incoming-order",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1b2c3d4-0001-0000-0000-000000000001",
      "name": "Order Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-1120, 200],
      "webhookId": "a1b2c3d4-0001-0000-0000-000000000001"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.body.customerId }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            },
            {
              "id": "c2",
              "leftValue": "={{ ($json.body.lineItems || []).length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0002-0000-0000-000000000002",
      "name": "Validate Payload",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-900, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseCode": 400,
        "responseBody": "={{ JSON.stringify({ error: \"Invalid payload: customerId and at least one line item are required.\" }) }}",
        "options": {}
      },
      "id": "a1b2c3d4-0003-0000-0000-000000000003",
      "name": "Respond 400",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [-680, 420]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, customer_id, name, email FROM customers WHERE customer_id = $1 LIMIT 1;",
        "options": {
          "queryReplacement": "={{ $json.body.customerId }}"
        }
      },
      "id": "a1b2c3d4-0004-0000-0000-000000000004",
      "name": "Lookup Customer",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [-680, 100],
      "credentials": {
        "postgres": {
          "id": "REPLACE_POSTGRES_CRED_ID",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "combinator": "and",
          "conditions": [
            {
              "id": "e1",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0005-0000-0000-000000000005",
      "name": "Customer Exists?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-460, 100]
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": {
          "__rl": true,
          "mode": "list",
          "value": "public"
        },
        "table": {
          "__rl": true,
          "mode": "list",
          "value": "customers"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "customer_id": "={{ $('Order Webhook').item.json.body.customerId }}",
            "name": "={{ $('Order Webhook').item.json.body.customerName }}",
            "email": "={{ $('Order Webhook').item.json.body.customerEmail }}"
          }
        },
        "options": {}
      },
      "id": "a1b2c3d4-0006-0000-0000-000000000006",
      "name": "Insert Customer",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [-240, 280],
      "credentials": {
        "postgres": {
          "id": "REPLACE_POSTGRES_CRED_ID",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "fieldToSplitOut": "body.lineItems",
        "options": {}
      },
      "id": "a1b2c3d4-0007-0000-0000-000000000007",
      "name": "Split Line Items",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [-20, 100]
    },
    {
      "parameters": {
        "batchSize": 10,
        "options": {}
      },
      "id": "a1b2c3d4-0008-0000-0000-000000000008",
      "name": "Loop Over Items",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [200, 100]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://inventory.example.com/api/v1/stock/{{ $json.sku }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "id": "a1b2c3d4-0009-0000-0000-000000000009",
      "name": "Check Inventory",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [420, 100],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "#ops-alerts"
        },
        "text": "=:warning: Inventory check failed for SKU `{{ $json.sku }}` (order {{ $('Order Webhook').item.json.body.orderId }}). Error: {{ $json.error || 'unknown error' }}",
        "otherOptions": {}
      },
      "id": "a1b2c3d4-0010-0000-0000-000000000010",
      "name": "Slack Alert",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [640, 320],
      "webhookId": "a1b2c3d4-0010-0000-0000-000000000010",
      "credentials": {
        "slackApi": {
          "id": "REPLACE_SLACK_CRED_ID",
          "name": "Slack account"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const items = $input.all();\nconst order = $('Order Webhook').first().json.body;\nlet inStock = 0, outOfStock = 0, failed = 0;\nfor (const i of items) {\n  const j = i.json;\n  if (j.error) { failed++; continue; }\n  if (j.available && j.available > 0) inStock++; else outOfStock++;\n}\nreturn [{ json: {\n  orderId: order.orderId || null,\n  customerId: order.customerId,\n  totalItems: items.length,\n  inStock,\n  outOfStock,\n  failed,\n  fulfillable: outOfStock === 0 && failed === 0,\n  processedAt: new Date().toISOString()\n} }];"
      },
      "id": "a1b2c3d4-0011-0000-0000-000000000011",
      "name": "Aggregate Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, -120]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "REPLACE_GOOGLE_SHEET_ID"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Orders"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "orderId": "={{ $json.orderId }}",
            "customerId": "={{ $json.customerId }}",
            "totalItems": "={{ $json.totalItems }}",
            "inStock": "={{ $json.inStock }}",
            "outOfStock": "={{ $json.outOfStock }}",
            "failed": "={{ $json.failed }}",
            "fulfillable": "={{ $json.fulfillable }}",
            "processedAt": "={{ $json.processedAt }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "a1b2c3d4-0012-0000-0000-000000000012",
      "name": "Append Summary Row",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [640, -120],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_GSHEETS_CRED_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ status: \"processed\", summary: $json }) }}",
        "options": {}
      },
      "id": "a1b2c3d4-0013-0000-0000-000000000013",
      "name": "Respond Summary",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [860, -120]
    },
    {
      "parameters": {},
      "id": "a1b2c3d4-0014-0000-0000-000000000014",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [-1120, 640]
    },
    {
      "parameters": {
        "fromEmail": "alerts@example.com",
        "toEmail": "ops-team@example.com",
        "subject": "=[n8n] Workflow failed: {{ $json.workflow.name }}",
        "emailFormat": "text",
        "text": "=Workflow \"{{ $json.workflow.name }}\" (id {{ $json.workflow.id }}) failed.\n\nNode: {{ $json.execution.lastNodeExecuted }}\nError: {{ $json.execution.error.message }}\n\nExecution URL: {{ $json.execution.url }}",
        "options": {}
      },
      "id": "a1b2c3d4-0015-0000-0000-000000000015",
      "name": "Email On Failure",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [-900, 640],
      "credentials": {
        "smtp": {
          "id": "REPLACE_SMTP_CRED_ID",
          "name": "SMTP account"
        }
      }
    }
  ],
  "connections": {
    "Order Webhook": {
      "main": [
        [
          {
            "node": "Validate Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Payload": {
      "main": [
        [
          {
            "node": "Lookup Customer",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond 400",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Lookup Customer": {
      "main": [
        [
          {
            "node": "Customer Exists?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Customer Exists?": {
      "main": [
        [
          {
            "node": "Split Line Items",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Insert Customer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Insert Customer": {
      "main": [
        [
          {
            "node": "Split Line Items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Line Items": {
      "main": [
        [
          {
            "node": "Loop Over Items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Loop Over Items": {
      "main": [
        [
          {
            "node": "Aggregate Results",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Check Inventory",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Inventory": {
      "main": [
        [
          {
            "node": "Loop Over Items",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Slack Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Slack Alert": {
      "main": [
        [
          {
            "node": "Loop Over Items",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Aggregate Results": {
      "main": [
        [
          {
            "node": "Append Summary Row",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Append Summary Row": {
      "main": [
        [
          {
            "node": "Respond Summary",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Email On Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "errorWorkflow": "REPLACE_WITH_THIS_WORKFLOW_ID"
  }
}
