{
  "name": "Global Error Handler",
  "nodes": [
    {
      "parameters": {},
      "id": "b0000000-0000-0000-0000-000000000001",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "assignments": { "assignments": [
          { "id": "1", "name": "text", "type": "string",
            "value": "=:rotating_light: Workflow *{{ $json.workflow.name }}* failed at node *{{ $json.execution.lastNodeExecuted }}*\nError: {{ $json.execution.error.message }}\nExecution: {{ $json.execution.id }}" }
        ] },
        "options": {}
      },
      "id": "b0000000-0000-0000-0000-000000000002",
      "name": "Format Alert",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 0]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "post",
        "select": "channel",
        "channelId": { "__rl": true, "value": "C0XXXXXXX", "mode": "id" },
        "text": "={{ $json.text }}",
        "otherOptions": {}
      },
      "id": "b0000000-0000-0000-0000-000000000003",
      "name": "Notify Slack",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.3,
      "position": [440, 0],
      "credentials": { "slackApi": { "id": "<your-slack-credential-id>", "name": "Slack" } }
    }
  ],
  "connections": {
    "Error Trigger": { "main": [[ { "node": "Format Alert", "type": "main", "index": 0 } ]] },
    "Format Alert": { "main": [[ { "node": "Notify Slack", "type": "main", "index": 0 } ]] }
  },
  "settings": { "executionOrder": "v1" }
}
